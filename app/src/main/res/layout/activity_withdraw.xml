<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/withdraw_activity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_bg"
    android:fillViewport="true"
    tools:context=".WithdrawActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Screen: Không Toolbar, title 20sp căn giữa, back wrap_content (AGENTS.md) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingVertical="@dimen/spacing_md">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Quay lại"
                android:focusable="true"
                android:padding="@dimen/spacing_sm"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/withdrawal_header"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_screen_header"
                android:textStyle="bold" />

            <View
                android:layout_width="40dp"
                android:layout_height="1dp" />
        </LinearLayout>

        <!-- Thẻ Số Dư Khả Dụng -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_lg"
            android:layout_marginTop="@dimen/spacing_sm"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="@dimen/corner_radius_lg"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_color"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_current_balance"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_secondary" />

                <TextView
                    android:id="@+id/tvWithdrawBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="$0.000"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_big_number"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Form nhập thông tin rút tiền -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_xl">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/withdrawal_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_secondary" />

            <!-- 1. Tên ngân hàng (Dropdown menu chọn các ngân hàng tại Việt Nam) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilBankName"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:hint="@string/hint_bank_name"
                app:boxBackgroundColor="@color/surface"
                app:boxCornerRadiusBottomEnd="@dimen/corner_radius_sm"
                app:boxCornerRadiusBottomStart="@dimen/corner_radius_sm"
                app:boxCornerRadiusTopEnd="@dimen/corner_radius_sm"
                app:boxCornerRadiusTopStart="@dimen/corner_radius_sm"
                app:boxStrokeColor="@color/primary">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/actvBankName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_input" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 2. Số tài khoản (STK) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilAccountNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:hint="@string/hint_account_number"
                app:boxBackgroundColor="@color/surface"
                app:boxCornerRadiusBottomEnd="@dimen/corner_radius_sm"
                app:boxCornerRadiusBottomStart="@dimen/corner_radius_sm"
                app:boxCornerRadiusTopEnd="@dimen/corner_radius_sm"
                app:boxCornerRadiusTopStart="@dimen/corner_radius_sm"
                app:boxStrokeColor="@color/primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAccountNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_input" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 3. Tên chủ tài khoản (Người dùng tự nhập, viết HOA chuẩn ngân hàng và tự động lưu) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilAccountHolder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:hint="@string/hint_account_holder"
                app:boxBackgroundColor="@color/surface"
                app:boxCornerRadiusBottomEnd="@dimen/corner_radius_sm"
                app:boxCornerRadiusBottomStart="@dimen/corner_radius_sm"
                app:boxCornerRadiusTopEnd="@dimen/corner_radius_sm"
                app:boxCornerRadiusTopStart="@dimen/corner_radius_sm"
                app:boxStrokeColor="@color/primary"
                app:helperText="Nhập họ và tên chủ tài khoản (tự động lưu cho lần sau)"
                app:helperTextTextColor="@color/text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAccountHolder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_input" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Số tiền rút (USD) kèm nút MAX bên trong -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilWithdrawAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_withdraw_amount"
                    app:boxBackgroundColor="@color/surface"
                    app:boxCornerRadiusBottomEnd="@dimen/corner_radius_sm"
                    app:boxCornerRadiusBottomStart="@dimen/corner_radius_sm"
                    app:boxCornerRadiusTopEnd="@dimen/corner_radius_sm"
                    app:boxCornerRadiusTopStart="@dimen/corner_radius_sm"
                    app:boxStrokeColor="@color/primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWithdrawAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:maxLines="1"
                        android:paddingEnd="64dp"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_input" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/btnMaxAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="@dimen/spacing_sm"
                    android:paddingVertical="@dimen/spacing_xs"
                    android:text="MAX"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_button"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Nội dung rút tiền -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilWithdrawNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xl"
                android:hint="@string/hint_withdraw_note"
                app:boxBackgroundColor="@color/surface"
                app:boxCornerRadiusBottomEnd="@dimen/corner_radius_sm"
                app:boxCornerRadiusBottomStart="@dimen/corner_radius_sm"
                app:boxCornerRadiusTopEnd="@dimen/corner_radius_sm"
                app:boxCornerRadiusTopStart="@dimen/corner_radius_sm"
                app:boxStrokeColor="@color/primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etWithdrawNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="2"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_input" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Button xác nhận rút tiền -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitWithdraw"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/btn_submit_withdraw"
                android:textColor="@color/on_primary"
                android:textSize="@dimen/text_button"
                android:textStyle="bold"
                app:backgroundTint="@color/primary"
                app:cornerRadius="@dimen/corner_radius_md" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
