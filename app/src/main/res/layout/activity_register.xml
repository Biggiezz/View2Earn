<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_bg"
    android:fillViewport="true"
    android:id="@+id/register_activity"
    tools:context=".RegisterActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Screen: Không Toolbar, title 20sp căn giữa, back wrap_content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingVertical="@dimen/spacing_md">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Quay lại"
                android:focusable="true"
                android:padding="@dimen/spacing_sm"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/register_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_screen_header"
                android:textStyle="bold" />

            <View
                android:layout_width="40dp"
                android:layout_height="1dp" />
        </LinearLayout>

        <!-- Body Form Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_xl"
            android:paddingTop="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_xl">

            <!-- App Logo -->
            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="@dimen/spacing_md"
                android:contentDescription="@string/app_name"
                android:src="@drawable/logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/register_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_secondary" />

            <!-- Full Name Input -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:hint="@string/hint_full_name"
                app:boxCornerRadiusBottomEnd="@dimen/corner_radius_md"
                app:boxCornerRadiusBottomStart="@dimen/corner_radius_md"
                app:boxCornerRadiusTopEnd="@dimen/corner_radius_md"
                app:boxCornerRadiusTopStart="@dimen/corner_radius_md">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFullName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_input" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Email Input -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:hint="@string/hint_email"
                app:boxCornerRadiusBottomEnd="@dimen/corner_radius_md"
                app:boxCornerRadiusBottomStart="@dimen/corner_radius_md"
                app:boxCornerRadiusTopEnd="@dimen/corner_radius_md"
                app:boxCornerRadiusTopStart="@dimen/corner_radius_md">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_input" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password Input -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:hint="@string/hint_password"
                app:boxCornerRadiusBottomEnd="@dimen/corner_radius_md"
                app:boxCornerRadiusBottomStart="@dimen/corner_radius_md"
                app:boxCornerRadiusTopEnd="@dimen/corner_radius_md"
                app:boxCornerRadiusTopStart="@dimen/corner_radius_md"
                app:passwordToggleEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_input" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Confirm Password Input -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:hint="@string/hint_confirm_password"
                app:boxCornerRadiusBottomEnd="@dimen/corner_radius_md"
                app:boxCornerRadiusBottomStart="@dimen/corner_radius_md"
                app:boxCornerRadiusTopEnd="@dimen/corner_radius_md"
                app:boxCornerRadiusTopStart="@dimen/corner_radius_md"
                app:passwordToggleEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_input" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Register Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="@string/btn_register"
                android:textColor="@color/on_primary"
                android:textSize="@dimen/text_button"
                android:textStyle="bold"
                app:backgroundTint="@color/primary"
                app:cornerRadius="@dimen/corner_radius_md" />

            <!-- Login Navigation -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_xl"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_already_have_account"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_secondary" />

                <TextView
                    android:id="@+id/tvLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_login_now"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_secondary"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
